generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model barang {
  id             Int           @id @default(autoincrement())
  sku            String        @unique
  nama           String
  deskripsi      String?
  jumlah         Int           @default(0)
  kategoriId     Int
  lokasiGudangId Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  urlGambar      String?
  harga          Int?
  kategori       kategori      @relation(fields: [kategoriId], references: [id])
  lokasigudang   lokasigudang? @relation(fields: [lokasiGudangId], references: [id])
  riwayatscan    riwayatscan[]

  @@index([kategoriId])
  @@index([lokasiGudangId])
}

model kategori {
  id     Int      @id @default(autoincrement())
  nama   String   @unique
  barang barang[]
}

model lokasigudang {
  id          Int           @id @default(autoincrement())
  nama        String        @unique
  kapasitas   Int           @default(100)
  zona        String        @default("Rak 1")
  rak         String?
  baris       Int?
  keranjang   String?
  barang      barang[]
  riwayatscan riwayatscan[]
}

model riwayatpencarian {
  id         Int      @id @default(autoincrement())
  kataKunci  String
  dibuatPada DateTime @default(now())
}

model riwayatscan {
  id             Int           @id @default(autoincrement())
  barangId       Int?
  lokasiGudangId Int?
  jenis          String
  jumlah         Int
  catatan        String?
  dibuatPada     DateTime      @default(now())
  barang         barang?       @relation(fields: [barangId], references: [id])
  lokasigudang   lokasigudang? @relation(fields: [lokasiGudangId], references: [id])

  @@index([barangId])
  @@index([lokasiGudangId])
}
